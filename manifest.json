{
  "manifest_version": 3,
  "name": "Odoo Fiscal Printer Key",
  "version": "1.0.1",
  "description": "Stores a fiscal printer serial number and exposes it via localStorage on odoo.com pages so the Odoo POS / fiscal module can read it.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://odoo.com/*",
    "*://*.odoo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Odoo Fiscal Printer Key",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://odoo.com/*",
        "*://*.odoo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
